# --- chat model ids (must match the chosen provider) ---
# gemini:  gemini-2.5-flash / gemini-2.5-flash
# openai:  gpt-4o / gpt-4o-mini
# groq:    llama-3.3-70b-versatile / llama-3.1-8b-instant
# ollama:  llama3.1 / llama3.2

# LLM_MODEL =>          primary: generation + faithfulness judge
# LLM_FLASH_MODEL =>    fast: query rewrite, planning, fallback
# EVAL_JUDGE_MODEL =>   cheap judge (follows the provider)

# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:e4b
# LLM_FLASH_MODEL=gemma4:e4b
# EVAL_JUDGE_MODEL=gemma4:e4b
# OLLAMA_BASE_URL=http://localhost:11434


OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=""

# primary: generation + faithfulness judge
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile 

 # fast: query rewrite, planning, fallback
LLM_FLASH_PROVIDER=groq
LLM_FLASH_MODEL=llama-3.1-8b-instant

# run the RAGAS/DeepEval judge
EVAL_JUDGE_PROVIDER=ollama
EVAL_JUDGE_MODEL=gemma4:e4b


# --- local models (provider-independent; leave as-is unless you know why) ---
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- optional engine knobs (defaults in app/config.py) ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# CHROMA_PATH=storage/chroma
# RETRIEVAL_TOP_K=5
# RERANK_TOP_K=5
# MAX_ITERATIONS=2
# FAITHFULNESS_PASS_SCORE=0.85
# MAX_FAITHFULNESS_RETRIES=2

# --- optional LangSmith tracing (off by default) ---
# LANGCHAIN_TRACING=true
# LANGCHAIN_API_KEY=
